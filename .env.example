# Nidhi Diagnostic — Environment Variables
# Copy this file to .env and fill in your values.

# Flask
FLASK_CONFIG=production
FLASK_DEBUG=0
SECRET_KEY=<generate-a-random-32-char-string>
SECURITY_PASSWORD_SALT=<generate-another-random-string>

# PostgreSQL (Neon or other provider)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis (sessions + rate limiting)
UPSTASH_REDIS_URL=rediss://default:TOKEN@HOST:PORT

# Uploads
UPLOAD_FOLDER=uploads

# Cloudflare R2 (optional — set USE_CLOUD_STORAGE=1 to enable)
USE_CLOUD_STORAGE=0
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=YOUR_R2_ACCESS_KEY
R2_SECRET_KEY=YOUR_R2_SECRET_KEY
R2_BUCKET=nidhi-diagnostic
R2_PUBLIC_URL=https://pub-YOUR_TOKEN.r2.dev

# Gmail SMTP (uses App Password, not regular password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=Your Name <your-email@gmail.com>
